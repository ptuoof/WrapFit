PORT=5000

# Đường dẫn kết nối PostgreSQL (Ví dụ: Supabase, Neon, Railway hoặc PostgreSQL Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/wrapfit?schema=public"

# Cấu hình lưu trữ file S3 / Cloudflare R2
AWS_ACCESS_KEY_ID="your_aws_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="wrapfit-assets"
