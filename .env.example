# ===================================================
# WrapFit Full-Stack Docker Environment Configuration
# ===================================================

# Application Ports
FRONTEND_PORT=3000
PORT=5000
POSTGRES_PORT=5432

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=wrapfit

# Frontend Public API URL (accessible from the browser)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_NAME="WrapFit Studio"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
